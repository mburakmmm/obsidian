import obsidian.fields
import obsidian.format_json
from obsidian.fields import LogField
from obsidian.level import INFO
from obsidian.record import LogRecord

event_fields: list[LogField] = [LogField("user_id", obsidian.fields.string_value("u-123")), LogField("status", obsidian.fields.int_value(200)), LogField("token", obsidian.fields.string_value("SYNTHETIC_EXAMPLE_SECRET"))]
context_fields: list[LogField] = [LogField("request", obsidian.fields.string_value("req-42"))]
entry: LogRecord = LogRecord(1700000000123, INFO, "service.auth", "request completed", event_fields, context_fields)

print(obsidian.format_json.format_record(entry).removesuffix("\n"))
