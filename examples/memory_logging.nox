import obsidian.fields
from obsidian.clock import FakeClock
from obsidian.fields import LogField
from obsidian.level import INFO
from obsidian.logger import Logger
from obsidian.record import LogRecord
from obsidian.sinks.memory import MemorySink

fake_clock: FakeClock = FakeClock(1700000000000)
log_instance: Logger = Logger("service.auth", INFO, fake_clock)
memory: MemorySink = MemorySink("example-memory", 8)
log_instance.add_sink(memory)

event_fields: list[LogField] = [LogField("token", obsidian.fields.string_value("SYNTHETIC_EXAMPLE_SECRET"))]
log_instance.info("password=SYNTHETIC_EXAMPLE_SECRET", event_fields)

entry: LogRecord = memory.record_at(0)
print(entry.timestamp_ms, entry.level_name, entry.logger_name, entry.message, entry.field_at(0).value.text_value)
