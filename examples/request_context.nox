import obsidian.fields
import obsidian.format_json
from obsidian.clock import FakeClock
from obsidian.context import BoundLogger
from obsidian.fields import LogField
from obsidian.level import INFO
from obsidian.logger import Logger
from obsidian.sinks.memory import MemorySink

clock: FakeClock = FakeClock(1700000000123)
logger: Logger = Logger("service.http", INFO, clock)
memory: MemorySink = MemorySink("request-events", 4)
logger.add_sink(memory)

bound_fields: list[LogField] = [LogField("route", obsidian.fields.string_value("/health"))]
request_logger: BoundLogger = logger.bind(bound_fields, "req-42", "trace-7", "span-3")
event_fields: list[LogField] = [LogField("status", obsidian.fields.int_value(200))]
request_logger.info("request completed", event_fields)
print(obsidian.format_json.format_record(memory.record_at(0)), end="")
logger.close()
