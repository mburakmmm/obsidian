from obsidian.diagnostics import saturating_increment
from obsidian.record import LogRecord

class MemorySink:
    _name: str
    _capacity: int
    _records: list[LogRecord]
    _oldest: int
    _dropped: int
    _flushes: int
    _closed: bool

    def __init__(self, name: str, capacity: int) -> None:
        if len(name) == 0:
            raise ValueError("sink name must not be empty")
        if capacity < 1:
            raise ValueError("memory sink capacity must be positive")
        self._name = name
        self._capacity = capacity
        self._records = []
        self._oldest = 0
        self._dropped = 0
        self._flushes = 0
        self._closed = False

    def sink_name(self) -> str:

        return self._name

    def write(self, entry: LogRecord) -> None:

        if self._closed:
            raise ValueError("memory sink is closed")
        owned: LogRecord = entry.clone()
        if len(self._records) < self._capacity:
            self._records.append(owned)
            return
        self._records[self._oldest] = owned
        self._oldest = (self._oldest + 1) % self._capacity
        self._dropped = saturating_increment(self._dropped)

    def flush(self) -> None:

        if self._closed:
            raise ValueError("memory sink is closed")
        self._flushes = saturating_increment(self._flushes)

    def close(self) -> None:

        self._closed = True

    def is_closed(self) -> bool:

        return self._closed

    def is_bounded(self) -> bool:

        return True

    def count(self) -> int:

        return len(self._records)

    def dropped_count(self) -> int:

        return self._dropped

    def flush_count(self) -> int:

        return self._flushes

    def record_at(self, index: int) -> LogRecord:

        length: int = len(self._records)
        logical_index: int = index
        if logical_index < 0:
            logical_index += length
        if logical_index < 0 or logical_index >= length:
            # Keep the native list's error for the original index.
            return self._records[index].clone()
        until_wrap: int = length - self._oldest
        if logical_index >= until_wrap:
            return self._records[logical_index - until_wrap].clone()
        return self._records[self._oldest + logical_index].clone()

    def snapshot(self) -> list[LogRecord]:

        result: list[LogRecord] = []
        for index in range(len(self._records)):
            result.append(self.record_at(index))
        return result
