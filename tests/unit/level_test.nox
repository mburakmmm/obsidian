import obsidian.level
import nox.log
import nox.test
from obsidian.level import CRITICAL, DEBUG, ERROR, INFO, OFF, TRACE, WARN, WARNING

def unknown_name_raises() -> bool:
    try:
        obsidian.level.from_name("NOTICE")
        return False
    except ValueError as e:
        return e.message == "unknown Obsidian level name"

def unknown_value_raises() -> bool:
    try:
        obsidian.level.canonical_name(999)
        return False
    except ValueError as e:
        return e.message == "unknown Obsidian level"

def nox_warn_mapping_matches() -> bool:
    original: str = nox.log.level()
    try:
        nox.log.set_level("WARN")
        return nox.log.enabled("WARN") and not nox.log.enabled("INFO")
    finally:
        nox.log.set_level(original)

nox.test.assert_eq_int(TRACE, 5, "TRACE numeric severity")
nox.test.assert_eq_int(DEBUG, 10, "DEBUG numeric severity")
nox.test.assert_eq_int(INFO, 20, "INFO numeric severity")
nox.test.assert_eq_int(WARNING, 30, "WARNING numeric severity")
nox.test.assert_eq_int(WARN, WARNING, "WARN aliases WARNING")
nox.test.assert_eq_int(ERROR, 40, "ERROR numeric severity")
nox.test.assert_eq_int(CRITICAL, 50, "CRITICAL numeric severity")
nox.test.assert_eq_int(OFF, 100, "OFF numeric severity")

nox.test.assert_eq_str(obsidian.level.canonical_name(TRACE), "TRACE", "TRACE canonical name")
nox.test.assert_eq_str(obsidian.level.canonical_name(WARNING), "WARNING", "WARNING canonical name")
nox.test.assert_eq_str(obsidian.level.canonical_name(CRITICAL), "CRITICAL", "CRITICAL canonical name")
nox.test.assert_eq_str(obsidian.level.canonical_name(OFF), "OFF", "OFF canonical name")

nox.test.assert_eq_int(obsidian.level.from_name("TRACE"), TRACE, "parse TRACE")
nox.test.assert_eq_int(obsidian.level.from_name("WARN"), WARNING, "parse WARN alias")
nox.test.assert_eq_int(obsidian.level.from_name("WARNING"), WARNING, "parse WARNING")
nox.test.assert_eq_int(obsidian.level.from_name("OFF"), OFF, "parse OFF")

nox.test.assert_true(obsidian.level.is_valid(DEBUG), "DEBUG is valid")
nox.test.assert_true(obsidian.level.is_valid(OFF), "OFF is valid threshold")
nox.test.assert_true(not obsidian.level.is_valid(999), "unknown level is invalid")
nox.test.assert_true(obsidian.level.is_event_level(ERROR), "ERROR is event level")
nox.test.assert_true(not obsidian.level.is_event_level(OFF), "OFF is not event level")

nox.test.assert_true(obsidian.level.is_enabled(INFO, INFO), "equal threshold enabled")
nox.test.assert_true(obsidian.level.is_enabled(ERROR, INFO), "higher severity enabled")
nox.test.assert_true(not obsidian.level.is_enabled(DEBUG, INFO), "lower severity disabled")
nox.test.assert_true(not obsidian.level.is_enabled(CRITICAL, OFF), "OFF disables events")
nox.test.assert_true(not obsidian.level.is_enabled(OFF, TRACE), "OFF cannot be emitted")
nox.test.assert_true(not obsidian.level.is_enabled(999, TRACE), "unknown event disabled")
nox.test.assert_true(not obsidian.level.is_enabled(INFO, 999), "unknown threshold disables")

nox.test.assert_true(unknown_name_raises(), "unknown name raises")
nox.test.assert_true(unknown_value_raises(), "unknown numeric value raises")
nox.test.assert_true(nox_warn_mapping_matches(), "nox.log WARN mapping")
