import nox.test
import obsidian.config
import obsidian.factory
import obsidian.fields
import obsidian.format_json
import obsidian.format_text
import obsidian.integration
import obsidian.version
from obsidian.clock import Clock, FakeClock
from obsidian.config import FormatterConfig, LoggerConfig, RedactionConfig, SinkConfig
from obsidian.context import BoundLogger
from obsidian.diagnostics import DiagnosticsSnapshot
from obsidian.fields import FieldValue, LogField
from obsidian.filter import ExactLoggerNameFilter, LogFilter
from obsidian.level import DEBUG, INFO, WARNING
from obsidian.logger import Logger
from obsidian.record import LOG_SCHEMA_VERSION, LogRecord
from obsidian.redact import DefaultRedactor, RedactionPolicy, Redactor
from obsidian.rotation import RotationPolicy
from obsidian.sink import Sink
from obsidian.sink_format import FORMAT_JSON
from obsidian.sinks.memory import MemorySink

clock_impl: FakeClock = FakeClock(1700000000123)
clock: Clock = clock_impl
policy: RedactionPolicy = RedactionPolicy(["client_pin"])
redactor_impl: DefaultRedactor = DefaultRedactor(policy)
redactor: Redactor = redactor_impl
logger: Logger = Logger("beta.contract", DEBUG, clock, redactor)
memory_impl: MemorySink = MemorySink("beta-memory", 4)
sink: Sink = memory_impl
route_impl: ExactLoggerNameFilter = ExactLoggerNameFilter("beta.contract")
route: LogFilter = route_impl
registration_id: int = logger.add_sink_with_filter(sink, INFO, route)

context_fields: list[LogField] = [LogField("tenant", obsidian.fields.string_value("alpha"))]
bound: BoundLogger = logger.bind(context_fields, "req-1", "trace-1", "span-1")
event_fields: list[LogField] = [LogField("missing", obsidian.fields.null_value()), LogField("name", obsidian.fields.string_value("demo")), LogField("attempt", obsidian.fields.int_value(2)), LogField("ratio", obsidian.fields.float_value(1.5)), LogField("active", obsidian.fields.bool_value(True)), LogField("client_pin", obsidian.fields.string_value("SYNTHETIC_BETA_SECRET"))]

nox.test.assert_true(not logger.trace_event("disabled trace", []), "beta trace spelling remains available")
nox.test.assert_true(bound.info("ready", event_fields), "beta bound logger emits")
nox.test.assert_eq_int(clock_impl.reads, 1, "beta clock read once")
nox.test.assert_eq_int(memory_impl.count(), 1, "beta memory sink captures")

entry: LogRecord = memory_impl.record_at(0)
nox.test.assert_eq_str(entry.schema_version, LOG_SCHEMA_VERSION, "beta schema constant matches record")
nox.test.assert_eq_str(entry.request_id, "req-1", "beta request id captured")
nox.test.assert_eq_int(entry.field_count(), 6, "beta field count")
nox.test.assert_eq_int(entry.context_count(), 1, "beta context count")
nox.test.assert_eq_str(entry.field_at(5).value.text_value, "***", "beta custom redaction applied")
nox.test.assert_true("SYNTHETIC_BETA_SECRET" not in obsidian.format_json.format_record(entry), "beta JSON remains sanitized")
nox.test.assert_true("ready" in obsidian.format_text.format_record(entry), "beta text formatter available")

typed_value: FieldValue = obsidian.fields.bool_value(True)
nox.test.assert_true(typed_value.bool_value, "beta typed field factory available")
nox.test.assert_eq_int(obsidian.integration.request_completion_level(404), WARNING, "beta integration severity available")
nox.test.assert_eq_int(len(obsidian.integration.request_completion_fields("GET", 200, 5, "items.list")), 4, "beta integration fields available")

diagnostics: DiagnosticsSnapshot = logger.diagnostics_snapshot()
nox.test.assert_eq_int(diagnostics.total_failures(), 0, "beta diagnostics available")
nox.test.assert_true(logger.remove_sink(registration_id), "beta sink removal available")
logger.close()
memory_impl.close()
nox.test.assert_true(logger.is_closed(), "beta logger close available")

redaction_config: RedactionConfig = RedactionConfig(["session_key"])
logger_config: LoggerConfig = LoggerConfig("beta.factory", INFO, redaction_config)
formatter_config: FormatterConfig = FormatterConfig(FORMAT_JSON)
sink_config: SinkConfig = obsidian.config.memory_sink_config("factory-memory", 2)
factory_logger: Logger = obsidian.factory.build_logger(logger_config, [sink_config], FakeClock(1))
nox.test.assert_true(factory_logger.info("factory", []), "beta typed factory available")
factory_logger.close()

rotation_policy: RotationPolicy = RotationPolicy(1024, 2)
nox.test.assert_eq_int(rotation_policy.max_bytes, 1024, "beta rotation policy available")
nox.test.assert_true(len(obsidian.version.current_version()) > 0, "beta version accessor remains available")

