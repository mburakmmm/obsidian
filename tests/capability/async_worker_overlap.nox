import nox.atomic
import nox.thread
import nox.time
from nox.atomic import AtomicInt

async def yield_once(value: int) -> int:
    return value

async def overlap_worker(channel: ThreadChannel[int]) -> int:
    active_handle: int = await channel.recv()
    peak_handle: int = await channel.recv()
    ready_handle: int = await channel.recv()
    active: AtomicInt = nox.atomic.from_int_handle(active_handle)
    peak: AtomicInt = nox.atomic.from_int_handle(peak_handle)
    ready: AtomicInt = nox.atomic.from_int_handle(ready_handle)
    ready.increment()
    await channel.recv()
    now: int = active.increment()
    updating: bool = True
    while updating:
        observed: int = peak.load()
        if now <= observed:
            updating = False
        elif peak.compare_and_swap(observed, now):
            updating = False
    deadline_ms: int = nox.time.boot_ms() + 1000
    while active.load() < 2 and nox.time.boot_ms() < deadline_ms:
        pass
    if active.load() < 2:
        active.decrement()
        return -1
    checksum: int = 0
    i: int = 0
    while i < 20000000:
        checksum += i % 7
        i += 1
    active.decrement()
    return checksum

async def run() -> None:
    active: AtomicInt = nox.atomic.new_int(0)
    peak: AtomicInt = nox.atomic.new_int(0)
    ready: AtomicInt = nox.atomic.new_int(0)
    first_channel: ThreadChannel[int] = ThreadChannel[int](3)
    second_channel: ThreadChannel[int] = ThreadChannel[int](3)
    first: ThreadHandle[int] = nox.thread.start(overlap_worker, first_channel)
    second: ThreadHandle[int] = nox.thread.start(overlap_worker, second_channel)
    await first_channel.send(active.handle)
    await first_channel.send(peak.handle)
    await first_channel.send(ready.handle)
    await second_channel.send(active.handle)
    await second_channel.send(peak.handle)
    await second_channel.send(ready.handle)
    while ready.load() < 2:
        await spawn yield_once(0)
    await first_channel.send(1)
    await second_channel.send(1)
    first_result: int = await first.join()
    second_result: int = await second.join()
    print(peak.load(), first_result == second_result)
    ready.free()
    peak.free()
    active.free()

nox.thread.pool_run(4, run)
