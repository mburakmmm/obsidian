import nox.atomic
import nox.test
import nox.thread
import nox.time
import obsidian.fields
from nox.atomic import AtomicInt
from obsidian.clock import FakeClock
from obsidian.context import BoundLogger
from obsidian.fields import LogField
from obsidian.level import INFO
from obsidian.logger import Logger
from obsidian.record import LogRecord
from obsidian.sinks.memory import MemorySink

def dispatch(worker_id: int, dispatched_handle: int) -> bool:
    peer_count: AtomicInt = nox.atomic.from_int_handle(dispatched_handle)
    name: str = "worker-" + str(worker_id)
    request_id: str = "req-" + str(worker_id)
    clock: FakeClock = FakeClock(worker_id)
    logger: Logger = Logger(name, INFO, clock)
    sink: MemorySink = MemorySink(name, 32)
    logger.add_sink(sink)
    empty: list[LogField] = []
    bound: BoundLogger = logger.bind(empty, request_id)
    token_fields: list[LogField] = [LogField("token", obsidian.fields.int_value(worker_id))]
    accepted: bool = bound.info("first", token_fields)

    # Both workers must dispatch before either can finish. A bounded spin
    # keeps the current worker occupied and makes this an overlap test.
    peer_count.increment()
    deadline: int = nox.time.boot_ms() + 3000
    while peer_count.load() < 2 and nox.time.boot_ms() < deadline:
        pass
    overlapped: bool = peer_count.load() == 2

    index: int = 1
    while index < 32:
        if not bound.info("event-" + str(index), token_fields):
            accepted = False
        index += 1
    logger.close()

    if not accepted or not overlapped or sink.count() != 32 or sink.dropped_count() != 0 or not sink.is_closed():
        return False
    index = 0
    while index < 32:
        entry: LogRecord = sink.record_at(index)
        expected: str = "first"
        if index > 0:
            expected = "event-" + str(index)
        if entry.logger_name != name or entry.request_id != request_id or entry.timestamp_ms != worker_id or entry.message != expected:
            return False
        if entry.field_count() != 1 or entry.field_at(0).value.text_value != "***":
            return False
        index += 1
    return True

async def dispatch_worker(input: ThreadChannel[int]) -> int:
    worker_id: int = await input.recv()
    dispatched_handle: int = await input.recv()
    if dispatch(worker_id, dispatched_handle):
        return 1
    return 0

async def verify_dispatch() -> None:
    dispatched: AtomicInt = nox.atomic.new_int(0)
    first_input: ThreadChannel[int] = ThreadChannel[int](2)
    second_input: ThreadChannel[int] = ThreadChannel[int](2)
    first: ThreadHandle[int] = nox.thread.start(dispatch_worker, first_input)
    second: ThreadHandle[int] = nox.thread.start(dispatch_worker, second_input)
    await first_input.send(1)
    await first_input.send(dispatched.handle)
    await second_input.send(2)
    await second_input.send(dispatched.handle)
    first_ok: int = await first.join()
    second_ok: int = await second.join()
    dispatched.free()
    nox.test.assert_true(first_ok == 1 and second_ok == 1, "overlapping owned dispatch preserves order, context, masking and lifecycle")

nox.thread.pool_run(4, verify_dispatch)
