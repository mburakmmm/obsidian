import obsidian.fields
import obsidian.format_json
from obsidian.fields import LogField
from obsidian.level import INFO
from obsidian.record import LogRecord

event_fields: list[LogField] = [LogField("ok", obsidian.fields.bool_value(True))]
context_fields: list[LogField] = []
entry: LogRecord = LogRecord(0, INFO, "consumer", "package import", event_fields, context_fields)

print(obsidian.format_json.format_record(entry).removesuffix("\n"))
