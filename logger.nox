import obsidian.level
import obsidian.context
import obsidian.filter
import obsidian.redact
import obsidian.record
from obsidian.clock import Clock
from obsidian.config import LoggerConfig
from obsidian.context import BoundLogger, LogContext
from obsidian.diagnostics import DiagnosticsSnapshot, MAX_DIAGNOSTIC_COUNT, saturating_increment
from obsidian.fields import LogField
from obsidian.filter import AllowAllFilter, LogFilter
from obsidian.level import CRITICAL, DEBUG, ERROR, INFO, TRACE, WARNING
from obsidian.redact import RedactionResult, Redactor
from obsidian.record import LogRecord, MAX_FIELDS_PER_SECTION
from obsidian.sink import Sink
from obsidian.sink_error import SinkError

MAX_REDACTION_FAILURE_COUNT: int = MAX_DIAGNOSTIC_COUNT
MAX_SINKS: int = 64
MAX_SINK_REGISTRATION_ID: int = 2147483647

class Logger:
    logger_name: str
    threshold: int
    _clock: Clock
    _sinks: list[Sink]
    _sink_ids: list[int]
    _sink_thresholds: list[int]
    _sink_filters: list[LogFilter]
    _next_sink_id: int
    _closed: bool
    _dispatching: bool
    _reentry_detected: bool
    _redactor: Redactor
    _redaction_failures: int
    _filter_failures: int
    _sink_write_failures: int
    _sink_flush_failures: int
    _sink_close_failures: int
    _recursion_failures: int
    _raise_on_error: bool

    def __init__(self, logger_name: str, threshold: int, clock: Clock, redactor: Redactor | None = None, raise_on_error: bool = False) -> None:
        obsidian.record.validate_logger_name(logger_name)
        if not obsidian.level.is_valid(threshold):
            raise ValueError("logger threshold is invalid")
        self.logger_name = logger_name
        self.threshold = threshold
        self._clock = clock
        self._sinks = []
        self._sink_ids = []
        self._sink_thresholds = []
        self._sink_filters = []
        self._next_sink_id = 1
        self._closed = False
        self._dispatching = False
        self._reentry_detected = False
        if redactor is None:
            self._redactor = obsidian.redact.default_redactor()
        else:
            self._redactor = redactor
        self._redaction_failures = 0
        self._filter_failures = 0
        self._sink_write_failures = 0
        self._sink_flush_failures = 0
        self._sink_close_failures = 0
        self._recursion_failures = 0
        self._raise_on_error = raise_on_error

    def is_enabled(self, event_level: int) -> bool:

        return not self._closed and obsidian.level.is_enabled(event_level, self.threshold)

    def add_sink(self, target: Sink) -> int:

        return self.add_sink_with_filter(target, TRACE, AllowAllFilter())

    def add_sink_with_filter(self, target: Sink, minimum_level: int, record_filter: LogFilter) -> int:

        if self._closed:
            raise ValueError("logger is closed")
        self._ensure_mutation_allowed()
        if not obsidian.level.is_valid(minimum_level):
            raise ValueError("sink threshold is invalid")
        if len(self._sinks) >= MAX_SINKS:
            raise ValueError("logger has too many sinks")
        if self._next_sink_id > MAX_SINK_REGISTRATION_ID:
            raise ValueError("sink registration identifiers are exhausted")
        registration_id: int = self._next_sink_id
        self._next_sink_id += 1
        self._sinks.append(target)
        self._sink_ids.append(registration_id)
        self._sink_thresholds.append(minimum_level)
        self._sink_filters.append(record_filter)
        return registration_id

    def remove_sink(self, registration_id: int) -> bool:

        self._ensure_mutation_allowed()
        index: int = 0
        while index < len(self._sink_ids):
            if self._sink_ids[index] == registration_id:
                del self._sink_ids[index]
                del self._sinks[index]
                del self._sink_thresholds[index]
                del self._sink_filters[index]
                return True
            index += 1
        return False

    def log(self, event_level: int, message: str, event_fields: list[LogField]) -> bool:

        empty_context: list[LogField] = []
        return self._log_with_context(event_level, message, event_fields, LogContext(empty_context))

    def bind(self, fields: list[LogField], request_id: str = "", trace_id: str = "", span_id: str = "") -> BoundLogger:

        return BoundLogger(self, LogContext(fields, request_id, trace_id, span_id))

    def _log_with_context(self, event_level: int, message: str, event_fields: list[LogField], context: LogContext) -> bool:

        if not self.is_enabled(event_level):
            return False
        if self._reject_reentrant_operation():
            return False
        if len(event_fields) > MAX_FIELDS_PER_SECTION:
            raise ValueError("record has too many fields")
        self._dispatching = True
        self._reentry_detected = False
        try:
            effective_context: list[LogField] = obsidian.context.without_event_collisions(context.fields_snapshot(), event_fields)
            captured: LogRecord = LogRecord(self._clock.now_ms(), event_level, self.logger_name, message, event_fields, effective_context, context.request_id, context.trace_id, context.span_id)
            try:
                redaction: RedactionResult = self._redactor.sanitize(captured)
            except Exception:
                self._record_redaction_failure()
                return False
            if self._reentry_detected:
                self._record_redaction_failure()
                return False
            if redaction.failed:
                self._record_redaction_failure()
                return False
            safe_record: LogRecord = redaction.safe_record
            had_failure: bool = False
            index: int = 0
            while index < len(self._sinks):
                if obsidian.level.is_enabled(safe_record.event_level, self._sink_thresholds[index]):
                    allowed: bool = False
                    filter_failed: bool = False
                    self._reentry_detected = False
                    try:
                        allowed = self._sink_filters[index].allows(safe_record.clone())
                    except Exception:
                        self._filter_failures = saturating_increment(self._filter_failures)
                        had_failure = True
                        filter_failed = True
                    if self._reentry_detected:
                        if not filter_failed:
                            self._filter_failures = saturating_increment(self._filter_failures)
                        had_failure = True
                        allowed = False
                    if allowed:
                        write_failed: bool = False
                        self._reentry_detected = False
                        try:
                            self._sinks[index].write(safe_record.clone())
                        except Exception:
                            self._sink_write_failures = saturating_increment(self._sink_write_failures)
                            had_failure = True
                            write_failed = True
                        if self._reentry_detected:
                            if not write_failed:
                                self._sink_write_failures = saturating_increment(self._sink_write_failures)
                            had_failure = True
                index += 1
            if had_failure and self._raise_on_error:
                raise SinkError("logger dispatch failed")
            return not had_failure
        finally:
            self._reentry_detected = False
            self._dispatching = False

    def trace_event(self, message: str, event_fields: list[LogField]) -> bool:

        return self.log(TRACE, message, event_fields)

    def debug(self, message: str, event_fields: list[LogField]) -> bool:

        return self.log(DEBUG, message, event_fields)

    def info(self, message: str, event_fields: list[LogField]) -> bool:

        return self.log(INFO, message, event_fields)

    def warning(self, message: str, event_fields: list[LogField]) -> bool:

        return self.log(WARNING, message, event_fields)

    def error(self, message: str, event_fields: list[LogField]) -> bool:

        return self.log(ERROR, message, event_fields)

    def critical(self, message: str, event_fields: list[LogField]) -> bool:

        return self.log(CRITICAL, message, event_fields)

    def flush(self) -> None:

        if self._closed:
            return
        if self._reject_reentrant_operation():
            return
        failed: bool = False
        self._dispatching = True
        self._reentry_detected = False
        try:
            for target in self._sinks:
                callback_failed: bool = False
                self._reentry_detected = False
                try:
                    target.flush()
                except Exception:
                    self._sink_flush_failures = saturating_increment(self._sink_flush_failures)
                    failed = True
                    callback_failed = True
                if self._reentry_detected:
                    if not callback_failed:
                        self._sink_flush_failures = saturating_increment(self._sink_flush_failures)
                    failed = True
        finally:
            self._reentry_detected = False
            self._dispatching = False
        if failed and self._raise_on_error:
            raise SinkError("logger flush failed")

    def close(self) -> None:

        if self._closed:
            return
        if self._reject_reentrant_operation():
            return
        failed: bool = False
        self._dispatching = True
        self._reentry_detected = False
        try:
            for target in self._sinks:
                callback_failed: bool = False
                self._reentry_detected = False
                try:
                    target.close()
                except Exception:
                    self._sink_close_failures = saturating_increment(self._sink_close_failures)
                    failed = True
                    callback_failed = True
                if self._reentry_detected:
                    if not callback_failed:
                        self._sink_close_failures = saturating_increment(self._sink_close_failures)
                    failed = True
        finally:
            self._closed = True
            self._reentry_detected = False
            self._dispatching = False
        if failed and self._raise_on_error:
            raise SinkError("logger close failed")

    def is_closed(self) -> bool:

        return self._closed

    def redaction_failure_count(self) -> int:

        return self._redaction_failures

    def diagnostics_snapshot(self) -> DiagnosticsSnapshot:

        return DiagnosticsSnapshot(self._redaction_failures, self._filter_failures, self._sink_write_failures, self._sink_flush_failures, self._sink_close_failures, self._recursion_failures)

    def reconfigure(self, config: LoggerConfig) -> None:

        if self._closed:
            raise ValueError("logger is closed")
        self._ensure_mutation_allowed()
        validated: LoggerConfig = LoggerConfig(config.logger_name(), config.threshold(), config.redaction(), config.raise_on_error())
        next_name: str = validated.logger_name()
        next_threshold: int = validated.threshold()
        next_redactor: Redactor = validated.redaction().build_redactor()
        next_raise_on_error: bool = validated.raise_on_error()
        self.logger_name = next_name
        self.threshold = next_threshold
        self._redactor = next_redactor
        self._raise_on_error = next_raise_on_error

    def _record_redaction_failure(self) -> None:

        self._redaction_failures = saturating_increment(self._redaction_failures)

    def _reject_reentrant_operation(self) -> bool:

        if not self._dispatching:
            return False
        self._recursion_failures = saturating_increment(self._recursion_failures)
        self._reentry_detected = True
        if self._raise_on_error:
            raise ValueError("recursive logger operation is not allowed")
        return True

    def _ensure_mutation_allowed(self) -> None:

        if self._dispatching:
            self._recursion_failures = saturating_increment(self._recursion_failures)
            self._reentry_detected = True
            raise ValueError("logger mutation during dispatch is not allowed")
