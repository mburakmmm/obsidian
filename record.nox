import obsidian.fields
import obsidian.field_set
import obsidian.level
import obsidian.context
from obsidian.fields import LogField

LOG_SCHEMA_VERSION: str = "obsidian.log.v1"
MAX_MESSAGE_LENGTH: int = 65536
MAX_FIELDS_PER_SECTION: int = 256

class LogRecord:
    timestamp_ms: int
    event_level: int
    level_name: str
    logger_name: str
    message: str
    _fields: list[LogField]
    _context: list[LogField]
    request_id: str
    trace_id: str
    span_id: str
    schema_version: str

    def __init__(self, timestamp_ms: int, event_level: int, logger_name: str, message: str, event_fields: list[LogField], context: list[LogField], request_id: str = "", trace_id: str = "", span_id: str = "") -> None:
        if timestamp_ms < 0:
            raise ValueError("timestamp must not be negative")
        if not obsidian.level.is_event_level(event_level):
            raise ValueError("record level must be an event level")
        validate_logger_name(logger_name)
        validate_message(message)
        if len(event_fields) > MAX_FIELDS_PER_SECTION or len(context) > MAX_FIELDS_PER_SECTION:
            raise ValueError("record has too many fields")
        obsidian.field_set.validate_unique_field_keys(event_fields)
        obsidian.field_set.validate_unique_field_keys(context)
        obsidian.context.validate_correlation_id(request_id)
        obsidian.context.validate_correlation_id(trace_id)
        obsidian.context.validate_correlation_id(span_id)
        self.timestamp_ms = timestamp_ms
        self.event_level = event_level
        self.level_name = obsidian.level.canonical_name(event_level)
        self.logger_name = logger_name
        self.message = message
        self._fields = obsidian.fields.clone_fields(event_fields)
        self._context = obsidian.fields.clone_fields(context)
        self.request_id = request_id
        self.trace_id = trace_id
        self.span_id = span_id
        self.schema_version = LOG_SCHEMA_VERSION

    def field_count(self) -> int:

        return len(self._fields)

    def context_count(self) -> int:

        return len(self._context)

    def field_at(self, index: int) -> LogField:

        return self._fields[index].clone()

    def context_at(self, index: int) -> LogField:

        return self._context[index].clone()

    def fields_snapshot(self) -> list[LogField]:

        return obsidian.fields.clone_fields(self._fields)

    def context_snapshot(self) -> list[LogField]:

        return obsidian.fields.clone_fields(self._context)

    def clone(self) -> LogRecord:

        return LogRecord(self.timestamp_ms, self.event_level, self.logger_name, self.message, self._fields, self._context, self.request_id, self.trace_id, self.span_id)

def validate_message(message: str) -> None:
    if len(message) > MAX_MESSAGE_LENGTH:
        raise ValueError("record message is too long")

def validate_logger_name(logger_name: str) -> None:
    if len(logger_name) == 0:
        raise ValueError("logger name must not be empty")
    if len(logger_name) > 128:
        raise ValueError("logger name is too long")
    if "\n" in logger_name or "" in logger_name or "\t" in logger_name:
        raise ValueError("logger name contains a control character")
